# ============================================================================
# Dataist arXiv Pipeline API -- example environment variables
# Copy to .env and fill in real values before running.
# ============================================================================

# --- LLM -------------------------------------------------------------------
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3

# --- Telegram delivery -----------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABC-REPLACE_ME
TELEGRAM_CHAT_ID=-1001234567890

# --- Asset storage ----------------------------------------------------------
ASSET_STORAGE_TYPE=local
ASSET_STORAGE_PATH=./published
ASSET_PUBLIC_BASE_URL=http://localhost:8000/static

# --- Profile selectors ------------------------------------------------------
PROMPT_PROFILE_ID=default_ai_editorial_v1
STYLE_PROFILE_ID=cinematic_orange_violet_v1
HTML_TEMPLATE_PROFILE_ID=dataist_article_v1

# --- Image generation -------------------------------------------------------
REFERENCE_IMAGE_URL=

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
